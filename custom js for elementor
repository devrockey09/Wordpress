
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css">
<link href="https://cdn.jsdelivr.net/npm/ti-icons@0.1.2/css/themify-icons.min.css" rel="stylesheet">
<script type="text/javascript">
	jQuery(document).ready(function(){
    jQuery(window).scroll(function(){
        var sTop= jQuery(this).scrollTop();
        if(sTop > 0){
            jQuery('.main-nav').addClass('navbar-fixed');
        } else {
            jQuery('.main-nav').removeClass('navbar-fixed');
        }
    });
});
	
	function scrollTop() {
  const header = document.querySelector(".scroll-top-btn");

  if (window.scrollY > 150) {
    header.classList.add("active");
  } else {
    header.classList.remove("active");
  }
}

window.addEventListener("scroll", scrollTop);
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.wpr-nav-menu .wpr-menu-item span').forEach(function (span) {
    span.setAttribute('data-text', span.textContent);
  });
});
</script>
